DATABASE_URL="postgresql://postgres:password@localhost:5432/crptopay?schema=public"
PORT=3001

# HD wallet mnemonic - generates unique deposit addresses (KEEP SECRET!)
MASTER_MNEMONIC="your twelve word mnemonic phrase goes here for testing only"

# Main treasury wallet that receives swept funds
TREASURY_ADDRESS="0xYourMainMetaMaskAddressHere"

# Default network for new payments (1=Mainnet, 137=Polygon, 11155111=Sepolia)
DEFAULT_CHAIN_ID=11155111

# How often to check for incoming payments (ms)
POLL_INTERVAL_MS=15000
# How often to retry treasury sweeps (ms). Confirmed ERC-20 deposits also sweep immediately.
SWEEP_INTERVAL_MS=15000

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Help bot
# Default: answer from StackPay system knowledge (no API key needed)
# HELP_BOT_MODE="knowledge"   # knowledge | hybrid | ai
#
# Optional external AI (OpenAI-compatible) for freer wording:
# HELP_BOT_AI_API_KEY="sk-..."
# HELP_BOT_AI_BASE_URL="https://api.openai.com/v1"
# HELP_BOT_AI_MODEL="gpt-4o-mini"
# Then set HELP_BOT_MODE="hybrid" or "ai"

# Auth secret — change in production!
JWT_SECRET="your-random-secret-key-change-me"

# Admin account (created/updated on server start)
ADMIN_EMAIL="admin@stackpay.com"
ADMIN_PASSWORD="change-this-admin-password"
